/* Dark Premium Theme for YouTube Live Link */

QMainWindow {
    background-color: #121212;
    color: #e0e0e0;
}

QLabel {
    color: #e0e0e0;
    font-size: 14px;
    font-family: 'Segoe UI', sans-serif;
}

QLineEdit {
    background-color: #1e1e1e;
    border: 1px solid #333;
    border-radius: 8px;
    padding: 10px;
    color: #fff;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid #3d5afe;
}

QPushButton {
    background-color: #3d5afe;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #536dfe;
}

QPushButton:pressed {
    background-color: #2979ff;
}

QPushButton#stopButton {
    background-color: #f44336;
}

QPushButton#stopButton:hover {
    background-color: #ef5350;
}

QFrame#card {
    background-color: #1e1e1e;
    border-radius: 12px;
    border: 1px solid #2c2c2c;
}

QListWidget {
    background-color: #1e1e1e;
    border: none;
    border-radius: 8px;
    color: #ccc;
    font-size: 13px;
    padding: 5px;
}

QProgressBar {
    background-color: #2c2c2c;
    border: none;
    border-radius: 5px;
    text-align: center;
    color: #fff;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3d5afe, stop:1 #8c9eff);
    border-radius: 5px;
}

QLabel#statusConnected {
    color: #4caf50;
    font-weight: bold;
}

QLabel#statusDisconnected {
    color: #f44336;
    font-weight: bold;
}

QLabel#headerTitle {
    font-size: 24px;
    font-weight: bold;
    color: #fff;
}

QScrollArea#optionsScroll {
    background-color: #1e1e1e;
    border: 1px solid #333;
    border-radius: 8px;
}

QScrollArea#optionsScroll QWidget {
    background-color: #1e1e1e;
}

QPushButton#addOptionButton {
    background-color: #2c2c2c;
    border: 1px dashed #555;
    color: #aaa;
}

QPushButton#addOptionButton:hover {
    background-color: #333;
    border-color: #3d5afe;
    color: #fff;
}

QPushButton#deleteOptionButton {
    background-color: #b71c1c;
    font-size: 12px;
    padding: 5px;
}

QPushButton#deleteOptionButton:hover {
    background-color: #d32f2f;
}

/* Custom ScrollBar */
QScrollBar:vertical {
    border: none;
    background: #121212;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #333;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #444;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
